{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NabuCode",
  "mainBinaryName": "NabuCode",
  "identifier": "dev.nabu.everyend",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build/ui"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "copyright": "© 2026 Koleso333",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "customLanguageFiles": { "Russian": "installer/Russian.nsh", "English": "installer/English.nsh" },
        "installerIcon": "installer/installer.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
